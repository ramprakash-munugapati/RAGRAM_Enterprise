# ----------------------------------------------------------------------
# .env – environment variables for RAGRAM Enterprise
# ----------------------------------------------------------------------
# LLM provider credentials
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Ollama (local LLM) – URL where Ollama is listening
OLLAMA_URL=http://localhost:11434

# Database connection
#   • SQLite for demo (default).  Replace with a PostgreSQL URL for production.
DB_URL=sqlite:///:memory:

# Backend selection – which generation backend to use at runtime
#   Accepted values: "openai", "anthropic", "ollama"
#   If omitted, the code falls back to "openai" if OPENAI_API_KEY is set,
#  otherwise "anthropic" if that key is set, otherwise "ollama".
RAGMA_BACKEND=openai

# Miscellaneous tuning (must match the EnterpriseConfig defaults)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200